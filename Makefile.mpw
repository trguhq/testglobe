# testglobe - native Apple MPW C / System 7 / 68000 build.# This file is MacRoman with CR newlines, as required by native MPW Make.# Run from the repository root in MPW Shell:#   Make -f Makefile.mpw quickdraw > QDBuild#   Execute QDBuild# From src, use -f ::Makefile.mpw -d QD_SRC=:# Preserve the output application resource fork when transferring it.QD_APP = TestglobeQDQD_SRC = :src:QD_CC = CQD_LINK = LinkQD_REZ = Rez# drv_qd.h selects QUAD/DRV_QUAD_BATCH; globe_draw_quadbatches submits packets.QD_DEFINES = -d SEG68 -d DRV_QD -d DRV -d NO_SINF# Apple MPW C defaults to 68000 instructions and SANE floating point.# Do not put -mc68020 or -mc68881 in these baseline flags.QD_CFLAGS =QD_FPFLAGS = -mc68020 -mc68881QD_LDFLAGS = -w -t APPL -c Tglo -sn STDIO=Main -sn INTENV=Main -sn %A5Init=MainQD_RUNTIME = "{Libraries}Runtime.o"QD_LIBRARIES = "{Libraries}Stubs.o" "{CLibraries}StdCLib.o" ¶	"{CLibraries}Math.o" "{CLibraries}CSANELib.o" ¶	"{Libraries}Interface.o" {QD_RUNTIME} "{Libraries}ToolLibs.o"QD_OBJECTS = q_drv.o q_qd.o q_err.o q_globe.o q_main.o q_fpu.o q_soft.oQD_HEADERS = {QD_SRC}testglob.h {QD_SRC}types.h {QD_SRC}drv.h ¶	{QD_SRC}drv_ext.h {QD_SRC}drv_qd.h {QD_SRC}qd_math.h ¶	{QD_SRC}err_ext.h {QD_SRC}globe.h {QD_SRC}glob_ext.h ¶	{QD_SRC}e_cmap.h {QD_SRC}earthres.h {QD_SRC}soft3d.h# READ paths in qd.r resolve from its source directory, outside -i/-s lists.QD_RESOURCE_DATA = {QD_SRC}:data:e32.bin {QD_SRC}:data:e64.bin {QD_SRC}:data:e128.bin ¶	{QD_SRC}:data:e256_0.bin {QD_SRC}:data:e256_1.bin ¶	{QD_SRC}:data:e512_0.bin {QD_SRC}:data:e512_1.bin {QD_SRC}:data:e512_2.bin ¶	{QD_SRC}:data:e512_3.bin {QD_SRC}:data:e512_4.bin {QD_SRC}:data:e512_5.bin ¶	{QD_SRC}:data:e512_6.bin {QD_SRC}:data:e512_7.binquickdraw Ä {QD_APP}{QD_APP} Ä {QD_OBJECTS} {QD_SRC}qd.r {QD_RESOURCE_DATA}	{QD_LINK} {QD_LDFLAGS} {QD_OBJECTS} {QD_LIBRARIES} -o {QD_APP}	{QD_REZ} -i "{RIncludes}" -i {QD_SRC} ¶	    {QD_SRC}qd.r -append -o {QD_APP}q_drv.o Ä {QD_SRC}drv.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}drv.c -o q_drv.oq_qd.o Ä {QD_SRC}drv_qd.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}drv_qd.c -o q_qd.oq_err.o Ä {QD_SRC}err.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}err.c -o q_err.oq_globe.o Ä {QD_SRC}globe.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}globe.c -o q_globe.oq_main.o Ä {QD_SRC}main.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}main.c -o q_main.o# Shared integer-only geometry stays in the baseline 68000 code.q_soft.o Ä {QD_SRC}soft3d.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}soft3d.c -o q_soft.o# qd_fpu.c has a QDFPU CODE-segment pragma and a pointer-only interface.# No 68881 instructions are run until the driver validates CPU and FPU.q_fpu.o Ä {QD_SRC}qd_fpu.c {QD_HEADERS}	{QD_CC} {QD_DEFINES} {QD_CFLAGS} {QD_FPFLAGS} -i "{CIncludes}" ¶	    -i {QD_SRC} {QD_SRC}qd_fpu.c -o q_fpu.oclean Ä	Delete -y {QD_OBJECTS} {QD_APP}